#include <stdio.h>
void printBinary(int n)
{ for (int i = 31; i >= 0; i--)
  { int bit = (n >> i) & 1;
  printf("%d", bit);
  } printf("\n"); }
int main() { int a = 10, b = 3;
printf("--- АРИФМЕТИЧНІ ОПЕРАТОРИ ---\n");
printf("a = %d, b = %d\n", a, b);
printf("a + b = %d\n", a + b);
printf("a - b = %d\n", a - b);
printf("a * b = %d\n", a * b);
printf("a / b = %d\n", a / b);
printf("a %% b = %d\n", a % b);
printf("a++ = %d (тепер a = %d)\n", a++, a);
printf("--b = %d (тепер b = %d)\n", --b, b);

printf("\n--- ПОРІВНЯННЯ ТА ЛОГІКА ---\n");
printf("a > b: %d\n", a > b);
printf("a < b: %d\n", a < b);
printf("a == b: %d\n", a == b);
printf("a != b: %d\n", a != b);
printf("a >= b: %d\n", a >= b);
printf("a <= b: %d\n", a <= b);
printf("(a > 0) && (b > 0): %d\n", (a > 0) && (b > 0));
printf("(a < 0) || (b > 0): %d\n", (a < 0) || (b > 0));
printf("!(a > 0): %d\n", !(a > 0));

printf("\n--- ПОБІТОВІ ОПЕРАТОРИ ---\n");
printf("a в двійковому вигляді: ");
printBinary(a);
printf("b в двійковому вигляді: ");
printBinary(b);

printf("\na & b = %d; двійковий вигляд: ", a & b);
printBinary(a & b);

printf("a | b = %d; двійковий вигляд: ", a | b);
printBinary(a | b);

printf("a ^ b = %d; двійковий вигляд: ", a ^ b);
printBinary(a ^ b);

printf("~a = %d; двійковий вигляд: ", ~a);
printBinary(~a);

printf("a << 1 = %d; двійковий вигляд: ", a << 1);
printBinary(a << 1);

printf("a >> 1 = %d; двійковий вигляд: ", a >> 1);
printBinary(a >> 1);

return 0;
}





